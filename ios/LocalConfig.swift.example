import Foundation

/// 复制到 PivisHealth/LocalConfig.swift 并改成你自己的服务器地址（那个文件不进 git）。
enum LocalConfig {
    /// P-Health 服务器所在机器的地址（内网 IP 或域名）
    static let serverHost = "127.0.0.1"
    /// 应用内更新：安装页所在的 HTTPS 地址（受信任证书），例如 "your-host.example.com:8443"；留空则不检查更新
    static let installHost = ""
    /// App 设备密钥：和服务器 ~/.config/pivis-health/app_key 里的一致（换 DSH 令牌时带上）；留空则只有本机服务器能用对话
    static let appKey = ""
}
